# Embeat UI configuration
# Copy this file to `.env` and adjust values for your deployment.
# Real environment variables always override the values below.

# Absolute path to the Embeat ML backend repository (contains the `infer` directory).
EMBEAT_ROOT=../Embeat

# Qdrant vector database connection.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=spotify_tracks
QDRANT_TIMEOUT=30

# Default music platform API endpoints surfaced in the UI.
# Leave empty to hide a default and let users fill it in manually.
NETEASE_API_URL=
KUGOU_API_URL=

# Optional HTTP proxy used for outbound requests (e.g. when direct connections are blocked).
PROXY_URL=

# Web UI bind address and port.
UI_HOST=0.0.0.0
UI_PORT=8765

# Optional registration invite code. Leave empty to allow open registration.
INVITE_CODE=